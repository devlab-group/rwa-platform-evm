{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://rwa-platform/schemas/metadata.schema.json",
  "title": "Metadata Envelope",
  "type": "object",
  "additionalProperties": false,
  "required": ["platformVersion", "projectId", "recordId", "asset", "issuance", "createdAt"],
  "properties": {
    "platformVersion": { "type": "string", "const": "1.0" },
    "projectId": { "type": "string", "format": "uuid" },
    "recordId": { "type": "string", "pattern": "^[A-Za-z0-9._:-]{1,128}$" },
    "asset": { "type": "object" },
    "issuance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["amount", "unit"],
      "properties": {
        "amount": { "type": "string", "pattern": "^[0-9]+$" },
        "unit": { "type": "string", "minLength": 1 }
      }
    },
    "proofs": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["type", "sha256"],
        "properties": {
          "type": { "type": "string", "minLength": 1 },
          "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
          "uri": { "type": "string" }
        }
      }
    },
    "createdAt": { "type": "string", "format": "date-time" }
  }
}
