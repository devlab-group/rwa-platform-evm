{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://rwa-platform/schemas/asset-profile.schema.json",
  "title": "Asset Profile",
  "type": "object",
  "additionalProperties": false,
  "required": ["profileVersion", "projectId", "assetType", "tokenUnit", "tokenDecimals", "recordIdLabel", "assetSchema"],
  "properties": {
    "profileVersion": { "type": "string", "const": "1.0" },
    "projectId": { "type": "string", "format": "uuid" },
    "assetType": { "type": "string", "minLength": 1, "maxLength": 128 },
    "tokenUnit": { "type": "string", "minLength": 1, "maxLength": 64 },
    "tokenDecimals": { "type": "integer", "minimum": 0, "maximum": 36 },
    "recordIdLabel": { "type": "string", "minLength": 1, "maxLength": 128 },
    "displayFields": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["label", "pointer"],
        "properties": {
          "label": { "type": "string", "minLength": 1 },
          "pointer": { "type": "string", "pattern": "^/" }
        }
      }
    },
    "legal": {
      "description": "Optional instrument description. Server and signer validation also require printable text (Go unicode.IsPrint, no C0/DEL/C1 controls), ISO 7064 MOD 97-10 check digits for issuerLei and a real calendar date for maturityDate.",
      "type": "object",
      "additionalProperties": false,
      "required": ["wrapper"],
      "properties": {
        "wrapper": { "type": "string", "enum": ["share", "entitlement", "certificate", "claim"] },
        "issuerLei": { "type": "string", "pattern": "^[A-Z0-9]{18}[0-9]{2}$" },
        "holderRights": { "type": "string", "minLength": 1, "maxLength": 2048 },
        "redemptionTerms": { "$ref": "#/$defs/documentReference" },
        "maturityDate": { "type": "string", "format": "date" },
        "rating": {
          "type": "object",
          "additionalProperties": false,
          "required": ["provider", "uri", "sha256"],
          "properties": {
            "provider": { "type": "string", "minLength": 1, "maxLength": 128 },
            "grade": { "type": "string", "minLength": 1, "maxLength": 32 },
            "uri": { "$ref": "#/$defs/uri" },
            "sha256": { "$ref": "#/$defs/sha256" }
          }
        }
      }
    },
    "assetSchema": { "type": "object" }
  },
  "$defs": {
    "uri": { "type": "string", "minLength": 1, "maxLength": 2048, "pattern": "^\\S+$" },
    "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "documentReference": {
      "type": "object",
      "additionalProperties": false,
      "required": ["uri", "sha256"],
      "properties": {
        "uri": { "$ref": "#/$defs/uri" },
        "sha256": { "$ref": "#/$defs/sha256" }
      }
    }
  }
}
