{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://rwa-platform/schemas/signed-result.schema.json",
  "title": "Signed Result",
  "type": "object",
  "additionalProperties": false,
  "required": ["formatVersion", "auditor", "primaryType", "typedDataDigest", "signature", "signedAt"],
  "properties": {
    "formatVersion": { "type": "string", "const": "1.0" },
    "auditor": { "type": "string", "pattern": "^0x[0-9a-fA-F]{40}$" },
    "primaryType": { "type": "string", "enum": ["MintAttestation", "BurnAttestation"] },
    "typedDataDigest": { "type": "string", "pattern": "^0x[0-9a-fA-F]{64}$" },
    "signature": { "type": "string", "pattern": "^0x[0-9a-fA-F]{130}$" },
    "signedAt": { "type": "string", "format": "date-time" }
  }
}
