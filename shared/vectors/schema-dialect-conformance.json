{
  "dialect": "rwa-profile-assetSchema/1",
  "description": "Differential conformance vectors for the operator assetSchema dialect (docs/spec/profile-schema-dialect.md). The server guard/compiler and the offline signer compiler MUST both produce the stated 'expect' (accept = schema compiles, reject = schema refused) for every case. Parity is a release gate. 'schema' is a full assetSchema document.",
  "cases": [
    { "name": "empty-object", "expect": "accept", "schema": {} },
    { "name": "type-object-basic", "expect": "accept", "schema": { "type": "object", "additionalProperties": false, "required": ["a"], "properties": { "a": { "type": "string" } } } },
    { "name": "type-array-of-strings", "expect": "accept", "schema": { "type": ["string", "null"] } },
    { "name": "string-constraints", "expect": "accept", "schema": { "type": "string", "minLength": 1, "maxLength": 64, "pattern": "^[a-z]+$" } },
    { "name": "number-bounds", "expect": "accept", "schema": { "type": "number", "minimum": 0, "maximum": 100, "exclusiveMinimum": -1, "exclusiveMaximum": 101 } },
    { "name": "integer-type", "expect": "accept", "schema": { "type": "integer", "minimum": 0, "maximum": 36 } },
    { "name": "array-constraints", "expect": "accept", "schema": { "type": "array", "items": { "type": "string" }, "minItems": 1, "maxItems": 10, "uniqueItems": true } },
    { "name": "enum", "expect": "accept", "schema": { "type": "string", "enum": ["a", "b", "c"] } },
    { "name": "const-scalar", "expect": "accept", "schema": { "const": "1.0" } },
    { "name": "const-value-with-schema-like-data", "expect": "accept", "note": "const value is opaque data, not a schema; keys inside it are not walked", "schema": { "const": { "oneOf": 1, "format": "x" } } },
    { "name": "enum-value-with-schema-like-data", "expect": "accept", "note": "enum values are opaque data", "schema": { "enum": [ { "allOf": true }, { "multipleOf": 3 } ] } },
    { "name": "additionalProperties-boolean-true", "expect": "accept", "schema": { "type": "object", "additionalProperties": true } },
    { "name": "additionalProperties-schema", "expect": "accept", "schema": { "type": "object", "additionalProperties": { "type": "string", "maxLength": 8 } } },
    { "name": "annotations-allowed", "expect": "accept", "schema": { "type": "string", "title": "Ticker", "description": "asset ticker", "default": "AAA", "examples": ["AAA"], "$comment": "note", "deprecated": false, "readOnly": true } },
    { "name": "local-ref-into-defs", "expect": "accept", "note": "$ref is sole member of its object; target lives in $defs", "schema": { "type": "object", "properties": { "child": { "$ref": "#/$defs/leaf" } }, "$defs": { "leaf": { "type": "string", "minLength": 1 } } } },
    { "name": "ref-root", "expect": "accept", "schema": { "$defs": { "self": { "type": "string" } }, "type": "object", "properties": { "x": { "$ref": "#/$defs/self" } } } },
    { "name": "nested-deep-valid", "expect": "accept", "schema": { "type": "object", "additionalProperties": false, "properties": { "rows": { "type": "array", "items": { "type": "object", "additionalProperties": false, "required": ["id"], "properties": { "id": { "type": "integer", "minimum": 0 }, "tags": { "type": "array", "items": { "type": "string" }, "uniqueItems": true } } } } } } },

    { "name": "reject-oneOf", "expect": "reject", "note": "composition", "schema": { "oneOf": [ { "type": "string" }, { "type": "integer" } ] } },
    { "name": "reject-anyOf", "expect": "reject", "schema": { "anyOf": [ { "type": "string" } ] } },
    { "name": "reject-allOf", "expect": "reject", "schema": { "allOf": [ { "type": "string" } ] } },
    { "name": "reject-not", "expect": "reject", "schema": { "not": { "type": "null" } } },
    { "name": "reject-if-then-else", "expect": "reject", "schema": { "if": { "type": "string" }, "then": { "minLength": 1 }, "else": { "type": "integer" } } },
    { "name": "reject-if-only", "expect": "reject", "schema": { "type": "object", "if": { "type": "string" } } },
    { "name": "reject-dynamicRef", "expect": "reject", "schema": { "$dynamicRef": "#meta" } },
    { "name": "reject-dynamicAnchor", "expect": "reject", "schema": { "$dynamicAnchor": "meta", "type": "object" } },
    { "name": "reject-anchor", "expect": "reject", "schema": { "$anchor": "x", "type": "object" } },
    { "name": "reject-unevaluatedProperties", "expect": "reject", "schema": { "type": "object", "unevaluatedProperties": false } },
    { "name": "reject-unevaluatedItems", "expect": "reject", "schema": { "type": "array", "unevaluatedItems": false } },
    { "name": "reject-multipleOf", "expect": "reject", "note": "server enforced it, signer ignored it", "schema": { "type": "integer", "multipleOf": 5 } },
    { "name": "reject-minProperties", "expect": "reject", "schema": { "type": "object", "minProperties": 1 } },
    { "name": "reject-maxProperties", "expect": "reject", "schema": { "type": "object", "maxProperties": 10 } },
    { "name": "reject-patternProperties", "expect": "reject", "schema": { "type": "object", "patternProperties": { "^x": { "type": "string" } } } },
    { "name": "reject-propertyNames", "expect": "reject", "schema": { "type": "object", "propertyNames": { "pattern": "^[a-z]+$" } } },
    { "name": "reject-dependentRequired", "expect": "reject", "schema": { "type": "object", "dependentRequired": { "a": ["b"] } } },
    { "name": "reject-dependentSchemas", "expect": "reject", "schema": { "type": "object", "dependentSchemas": { "a": { "type": "object" } } } },
    { "name": "reject-contains", "expect": "reject", "schema": { "type": "array", "contains": { "type": "string" } } },
    { "name": "reject-minContains", "expect": "reject", "schema": { "type": "array", "contains": { "type": "string" }, "minContains": 1 } },
    { "name": "reject-format", "expect": "reject", "note": "signer ignored format, server enforced it", "schema": { "type": "string", "format": "email" } },
    { "name": "reject-prefixItems", "expect": "reject", "schema": { "type": "array", "prefixItems": [ { "type": "string" } ] } },
    { "name": "reject-additionalItems", "expect": "reject", "schema": { "type": "array", "additionalItems": false } },
    { "name": "reject-contentEncoding", "expect": "reject", "schema": { "type": "string", "contentEncoding": "base64" } },
    { "name": "reject-unknown-keyword", "expect": "reject", "note": "closed allowlist rejects any unknown key", "schema": { "type": "string", "totallyMadeUpKeyword": 1 } },
    { "name": "reject-nested-forbidden", "expect": "reject", "note": "forbidden keyword deep in the tree", "schema": { "type": "object", "properties": { "x": { "type": "array", "items": { "format": "uuid" } } } } },
    { "name": "reject-ref-with-sibling-validation", "expect": "reject", "note": "$ref must be sole member", "schema": { "$defs": { "leaf": { "type": "string" } }, "type": "object", "properties": { "x": { "$ref": "#/$defs/leaf", "minLength": 2 } } } },
    { "name": "reject-ref-with-sibling-annotation", "expect": "reject", "note": "$ref must be sole member even next to an annotation", "schema": { "$defs": { "leaf": { "type": "string" } }, "type": "object", "properties": { "x": { "$ref": "#/$defs/leaf", "title": "X" } } } },
    { "name": "reject-remote-ref-http", "expect": "reject", "schema": { "$ref": "https://example.com/s.json" } },
    { "name": "reject-remote-ref-relative", "expect": "reject", "schema": { "$ref": "./other.json" } },
    { "name": "reject-ref-not-hash", "expect": "reject", "schema": { "$ref": "leaf" } },
    { "name": "reject-ref-unresolvable", "expect": "reject", "schema": { "type": "object", "properties": { "x": { "$ref": "#/$defs/missing" } } } },
    { "name": "reject-ref-cycle-direct", "expect": "reject", "note": "self-referential schema", "schema": { "$defs": { "loop": { "$ref": "#/$defs/loop" } }, "type": "object", "properties": { "x": { "$ref": "#/$defs/loop" } } } },
    { "name": "reject-ref-cycle-indirect", "expect": "reject", "schema": { "$defs": { "a": { "$ref": "#/$defs/b" }, "b": { "$ref": "#/$defs/a" } }, "type": "object", "properties": { "x": { "$ref": "#/$defs/a" } } } },
    { "name": "reject-bad-type-value", "expect": "reject", "schema": { "type": "stringy" } },
    { "name": "reject-empty-type-array", "expect": "reject", "note": "signer compiled [] as any-type; server rejected", "schema": { "type": [] } },
    { "name": "reject-defs-unused-forbidden-keyword", "expect": "reject", "note": "every $defs member must satisfy the dialect even if never $ref'd", "schema": { "type": "object", "$defs": { "unused": { "multipleOf": 2 } } } },
    { "name": "accept-defs-unused-valid", "expect": "accept", "note": "an unused-but-valid $defs member compiles", "schema": { "type": "object", "$defs": { "unused": { "type": "string", "minLength": 1 } } } }
  ],
  "limits": {
    "note": "Mirror of shared/schemas/structural-limits.json. Both binaries enforce EXACTLY these.",
    "maxUncompressedBytes": 1048576,
    "maxDepth": 32,
    "maxStringLength": 32768,
    "maxArrayItems": 4096,
    "maxObjectProperties": 4096
  },
  "instanceCases": [
    { "name": "string-ok", "schema": { "type": "string" }, "instance": "hi", "expectValid": "valid" },
    { "name": "string-type-mismatch", "schema": { "type": "string" }, "instance": 5, "expectValid": "invalid" },
    { "name": "integer-ok", "schema": { "type": "integer" }, "instance": 7, "expectValid": "valid" },
    { "name": "integer-rejects-float", "schema": { "type": "integer" }, "instance": 7.5, "expectValid": "invalid" },
    { "name": "number-accepts-int", "schema": { "type": "number" }, "instance": 7, "expectValid": "valid" },
    { "name": "null-type-ok", "schema": { "type": "null" }, "instance": null, "expectValid": "valid" },
    { "name": "boolean-ok", "schema": { "type": "boolean" }, "instance": false, "expectValid": "valid" },
    { "name": "type-union-ok", "schema": { "type": ["string", "null"] }, "instance": null, "expectValid": "valid" },
    { "name": "type-union-fail", "schema": { "type": ["string", "null"] }, "instance": 3, "expectValid": "invalid" },
    { "name": "enum-in", "schema": { "enum": ["a", "b"] }, "instance": "b", "expectValid": "valid" },
    { "name": "enum-out", "schema": { "enum": ["a", "b"] }, "instance": "c", "expectValid": "invalid" },
    { "name": "const-match", "schema": { "const": "1.0" }, "instance": "1.0", "expectValid": "valid" },
    { "name": "const-mismatch", "schema": { "const": "1.0" }, "instance": "2.0", "expectValid": "invalid" },
    { "name": "minLength-ok", "schema": { "type": "string", "minLength": 2 }, "instance": "ab", "expectValid": "valid" },
    { "name": "minLength-fail", "schema": { "type": "string", "minLength": 2 }, "instance": "a", "expectValid": "invalid" },
    { "name": "maxLength-fail", "schema": { "type": "string", "maxLength": 3 }, "instance": "abcd", "expectValid": "invalid" },
    { "name": "pattern-ok", "schema": { "type": "string", "pattern": "^[a-z]+$" }, "instance": "abc", "expectValid": "valid" },
    { "name": "pattern-fail", "schema": { "type": "string", "pattern": "^[a-z]+$" }, "instance": "ab1", "expectValid": "invalid" },
    { "name": "minimum-ok", "schema": { "type": "integer", "minimum": 0 }, "instance": 0, "expectValid": "valid" },
    { "name": "minimum-fail", "schema": { "type": "integer", "minimum": 0 }, "instance": -1, "expectValid": "invalid" },
    { "name": "exclusiveMaximum-fail", "schema": { "type": "number", "exclusiveMaximum": 10 }, "instance": 10, "expectValid": "invalid" },
    { "name": "required-present", "schema": { "type": "object", "required": ["a"], "properties": { "a": { "type": "string" } } }, "instance": { "a": "x" }, "expectValid": "valid" },
    { "name": "required-missing", "schema": { "type": "object", "required": ["a"], "properties": { "a": { "type": "string" } } }, "instance": {}, "expectValid": "invalid" },
    { "name": "additionalProperties-false-extra", "schema": { "type": "object", "additionalProperties": false, "properties": { "a": { "type": "string" } } }, "instance": { "a": "x", "b": 1 }, "expectValid": "invalid" },
    { "name": "additionalProperties-false-clean", "schema": { "type": "object", "additionalProperties": false, "properties": { "a": { "type": "string" } } }, "instance": { "a": "x" }, "expectValid": "valid" },
    { "name": "additionalProperties-schema-fail", "schema": { "type": "object", "additionalProperties": { "type": "string" } }, "instance": { "x": 5 }, "expectValid": "invalid" },
    { "name": "items-element-fail", "schema": { "type": "array", "items": { "type": "integer" } }, "instance": [1, "two"], "expectValid": "invalid" },
    { "name": "minItems-fail", "schema": { "type": "array", "minItems": 2, "items": { "type": "integer" } }, "instance": [1], "expectValid": "invalid" },
    { "name": "maxItems-fail", "schema": { "type": "array", "maxItems": 1, "items": { "type": "integer" } }, "instance": [1, 2], "expectValid": "invalid" },
    { "name": "uniqueItems-dup", "schema": { "type": "array", "uniqueItems": true, "items": { "type": "integer" } }, "instance": [1, 1], "expectValid": "invalid" },
    { "name": "uniqueItems-ok", "schema": { "type": "array", "uniqueItems": true, "items": { "type": "integer" } }, "instance": [1, 2], "expectValid": "valid" },
    { "name": "ref-resolved-valid", "schema": { "type": "object", "properties": { "x": { "$ref": "#/$defs/leaf" } }, "$defs": { "leaf": { "type": "string", "minLength": 1 } } }, "instance": { "x": "ok" }, "expectValid": "valid" },
    { "name": "ref-resolved-invalid", "schema": { "type": "object", "properties": { "x": { "$ref": "#/$defs/leaf" } }, "$defs": { "leaf": { "type": "string", "minLength": 1 } } }, "instance": { "x": "" }, "expectValid": "invalid" },
    { "name": "nested-object-deep-valid", "schema": { "type": "object", "additionalProperties": false, "properties": { "rows": { "type": "array", "items": { "type": "object", "additionalProperties": false, "required": ["id"], "properties": { "id": { "type": "integer", "minimum": 0 } } } } } }, "instance": { "rows": [ { "id": 0 }, { "id": 3 } ] }, "expectValid": "valid" },
    { "name": "nested-object-deep-invalid", "schema": { "type": "object", "additionalProperties": false, "properties": { "rows": { "type": "array", "items": { "type": "object", "additionalProperties": false, "required": ["id"], "properties": { "id": { "type": "integer", "minimum": 0 } } } } } }, "instance": { "rows": [ { "id": -1 } ] }, "expectValid": "invalid" }
  ],
  "limitCases": [
    { "name": "string-length", "kind": "string", "limit": 32768, "note": "Build assetSchema data = a JSON string of exactly `limit` UTF-8 BYTES (accept) and `limit`+1 bytes (reject) validated against {type:string}, using single-byte (ASCII) characters so byte length and rune count coincide. Both binaries construct identically. The unit is frozen as UTF-8 bytes -- see string-length-2byte/-3byte/-4byte for multi-byte value vectors and object-key-length/-4byte for the same bound applied to an object key." },
    { "name": "string-length-2byte", "kind": "string-2byte", "limit": 32768, "note": "A JSON string value built from the 2-byte-UTF-8 character U+00E9 (é), repeated as many whole times as fit and padded with single-byte 'x' filler, so the value's total UTF-8 BYTE length is exactly `limit` (accept) / `limit`+1 (reject); its rune count is far below `limit`. The signer previously measured string length in runes (utf8.RuneCountInString), so a value like this -- well under `limit` runes but at/over `limit` bytes -- was wrongly accepted where the server (byte-counting) rejects it." },
    { "name": "string-length-3byte", "kind": "string-3byte", "limit": 32768, "note": "Same construction as string-length-2byte using the 3-byte-UTF-8 character U+4E2D (中)." },
    { "name": "string-length-4byte", "kind": "string-4byte", "limit": 32768, "note": "Same construction as string-length-2byte using the 4-byte-UTF-8 character U+1F600 (😀)." },
    { "name": "object-key-length", "kind": "object-key", "limit": 32768, "note": "A JSON object with a single ASCII key of exactly `limit` bytes (accept) / `limit`+1 bytes (reject). The signer previously had NO length check on object keys at all (only on string values), so a key this long -- which the server's limits.go already rejected, since it checks every string token including keys -- was silently accepted by the signer." },
    { "name": "object-key-length-4byte", "kind": "object-key-4byte", "limit": 32768, "note": "Same as object-key-length but the key is built from the 4-byte-UTF-8 character U+1F600 (padded with ASCII 'x'), so its UTF-8 byte length is exactly `limit`/`limit`+1 while its rune count is far smaller -- pins that the key bound is byte-based, not rune-based, exactly like the value bound." },
    { "name": "array-items", "kind": "array", "limit": 4096, "note": "A JSON array of exactly `limit` integers (accept) and `limit`+1 (reject) against {type:array,items:{type:integer}}." },
    { "name": "object-properties", "kind": "object", "limit": 4096, "note": "A JSON object with exactly `limit` string-keyed props (accept) and `limit`+1 (reject) against {type:object}." },
    { "name": "depth", "kind": "depth", "limit": 32, "note": "A JSON value nested exactly `limit` deep (accept) and `limit`+1 deep (reject). Depth = number of nested containers." },
    { "name": "bytes", "kind": "bytes", "limit": 1048576, "note": "A raw JSON document of exactly `limit` uncompressed bytes (accept) and `limit`+1 bytes (reject)." }
  ],
  "envelopeCases": [
    { "name": "profile-clean", "target": "profile", "expectValid": "valid", "note": "A minimal well-formed asset profile.", "document": { "profileVersion": "1.0", "projectId": "aaaaaaaa-bbbb-4ccc-8ddd-eeeeeeeeeeee", "assetType": "bond", "tokenUnit": "USD", "tokenDecimals": 2, "recordIdLabel": "CUSIP", "assetSchema": { "type": "object" } } },
    { "name": "profile-unknown-top-field", "target": "profile", "expectValid": "invalid", "note": "Unknown top-level field must be rejected by strict decoding on both sides.", "document": { "profileVersion": "1.0", "projectId": "aaaaaaaa-bbbb-4ccc-8ddd-eeeeeeeeeeee", "assetType": "bond", "tokenUnit": "USD", "tokenDecimals": 2, "recordIdLabel": "CUSIP", "assetSchema": { "type": "object" }, "surprise": 1 } },
    { "name": "profile-unknown-displayFields-field", "target": "profile", "expectValid": "invalid", "note": "server previously ignored unknown fields inside displayFields[]; must now reject like the signer.", "document": { "profileVersion": "1.0", "projectId": "aaaaaaaa-bbbb-4ccc-8ddd-eeeeeeeeeeee", "assetType": "bond", "tokenUnit": "USD", "tokenDecimals": 2, "recordIdLabel": "CUSIP", "displayFields": [ { "label": "X", "pointer": "/x", "extra": true } ], "assetSchema": { "type": "object" } } }
  ]
}
