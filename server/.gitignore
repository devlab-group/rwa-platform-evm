# make platform and server/e2e/run_e2e.sh copy web/dist into internal/webui/dist before
# compilation. Ignore generated index.html and hashed assets; retain .gitkeep so
# go:embed all:dist resolves in bare checkouts (all: includes dotfiles).
internal/webui/dist/*
!internal/webui/dist/.gitkeep

# Compiled binaries (platform, opsctl, reindex) build here.
bin/

config.yaml
